# URL canônica do site (obrigatória em produção para SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://seudominio.com

# Opcionais — se omitidos, o código usa os fallbacks de src/config/site.ts
# NEXT_PUBLIC_GITHUB_URL=
# NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_EMAIL=

# Formulário de contato (Resend) — necessário para o envio funcionar
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx

# Remetente verificado no Resend (sandbox: onboarding@resend.dev)
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Destinatário das mensagens (no sandbox do Resend: só o e-mail da sua conta Resend)
# CONTACT_TO_EMAIL=
